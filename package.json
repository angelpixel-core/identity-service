{
  "name": "@angelpixel-core/identity-service",
  "version": "0.1.0",
  "description": "Enterprise Multi-Tenant Identity & Access Management Service",
  "main": "dist/interfaces/http/server.js",
  "bin": {
    "identity": "./bin/identity"
  },
  "scripts": {
    "dev:api": "tsx watch interfaces/http/server.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "storybook": "storybook dev -p 6006 --ci",
    "build-storybook": "storybook build",
    "build": "tsc",
    "showcase:capture": "tsx scripts/capture-showcase.ts",
    "docker:dev": "docker compose up --build -V -d",
    "docker:dev:down": "docker compose --profile '*' down",
    "docker:dev:clean": "docker compose --profile '*' down -v --remove-orphans",
    "docker:dev:logs": "docker compose logs -f api web",
    "docker:up": "docker compose up",
    "docker:down": "docker compose --profile '*' down",
    "docker:logs": "docker compose logs -f",
    "docker:cloud": "docker compose --profile cloud up -d floci",
    "docker:cloud:down": "docker compose --profile cloud rm -sf floci",
    "docker:ingress": "docker compose --profile ingress up -d",
    "docker:ingress:down": "docker compose --profile ingress rm -sf ingress",
    "demo:m2m": "tsx scripts/demo_m2m_client.ts",
    "test:unit": "NODE_ENV=test jest --config jest.config.js tests/unit",
    "test:integration": "NODE_ENV=test jest --config jest.config.js tests/integration --runInBand",
    "test:acceptance": "NODE_ENV=test jest --config jest.config.js tests/acceptance",
    "test:e2e": "NODE_ENV=test jest --config jest.config.js tests/e2e",
    "test:sdk": "NODE_ENV=test jest --config jest.config.js sdks/typescript/tests",
    "cert:generate": "bash deployments/tls/generate-local-certs.sh",
    "test:ingress": "bash scripts/test-ingress-routing.sh",
    "test:helm": "bash scripts/test-helm-chart.sh",
    "test:cicd": "bash scripts/test-cicd-pipeline.sh",
    "test:infra": "bash scripts/test-terraform-floci.sh",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-prometheus": "^0.301.2",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@storybook/react": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "playwright": "^1.65.1",
    "storybook": "^10.6.6",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "5.8.3",
    "vite": "^8.3.6"
  }
}

{
  "name": "@angelpixel-core/identity-service",
  "version": "0.1.0",
  "description": "Enterprise Multi-Tenant Identity & Access Management Service",
  "main": "dist/interfaces/http/server.js",
  "scripts": {
    "dev:api": "tsx watch interfaces/http/server.ts",
    "build": "tsc",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test:unit": "NODE_ENV=test jest --config jest.config.js tests/unit",
    "test:integration": "NODE_ENV=test jest --config jest.config.js tests/integration",
    "test:acceptance": "NODE_ENV=test jest --config jest.config.js tests/acceptance",
    "test:e2e": "NODE_ENV=test jest --config jest.config.js tests/e2e",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "5.8.3"
  }
}

# Server Configuration
PORT=4000
NODE_ENV=development

# Multi-Tenant Database
# (Desde la máquina host se conecta vía localhost:5432; dentro de la red Docker interna usaría db:5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=identity_db
POSTGRES_TEST_DB=identity_test_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/identity_db

# Cache Layer (Redis)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# Security & Tokens
JWT_SECRET=super-secret-tenant-key-minimum-32-characters
JWT_EXPIRATION_SECONDS=3600

# External OIDC Federation (Optional in development; required for Live mode)
# See docs/guides/oidc-federation-credentials.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

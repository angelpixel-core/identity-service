# Server Configuration
PORT=4000
NODE_ENV=development

# Multi-Tenant Database
# (Desde la máquina host se conecta vía localhost:5432; dentro de la red Docker interna usaría db:5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=identity_db
POSTGRES_TEST_DB=identity_test_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/identity_db

# Cache Layer (Redis)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# Security & Tokens
JWT_SECRET=super-secret-tenant-key-minimum-32-characters
JWT_EXPIRATION_SECONDS=3600

# External OIDC Federation (Optional in development; required for Live mode)
# See docs/guides/oidc-federation-credentials.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional metadata from Google OAuth JSON download (informational / future overrides):
# GOOGLE_PROJECT_ID=
# GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
# GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
# GOOGLE_REDIRECT_URI_CALLBACKS=http://localhost:3000/api/v1/auth/federation/google/callback,http://localhost:4000/api/v1/auth/federation/google/callback
# GOOGLE_JAVASCRIPT_ORIGINS=http://localhost:3000,http://localhost:4000
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

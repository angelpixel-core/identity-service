#!/usr/bin/env node

/**
 * AngelPixel Identity Service - Unified CLI
 * Herramienta de línea de comandos HTTP-First para interacción, pruebas y automatización.
 * No acoplada al backend; realiza llamadas de red HTTP reales contra la API en ejecución.
 */

import { performance } from 'perf_hooks';
import crypto from 'crypto';

// --- CONFIGURACIÓN Y CONSTANTES ---
const VERSION = '0.1.0';
const DEFAULT_BASE_URL = process.env.IDENTITY_API_URL || 'http://localhost:4000';

// --- UTILIDADES DE COLOR ANSI ---
const colors = {
  reset: '\x1b[0m',
  bold: '\x1b[1m',
  dim: '\x1b[2m',
  red: '\x1b[31m',
  green: '\x1b[32m',
  yellow: '\x1b[33m',
  blue: '\x1b[34m',
  magenta: '\x1b[35m',
  cyan: '\x1b[36m',
  gray: '\x1b[90m',
};

// Resaltador de sintaxis JSON ligero
function highlightJson(jsonStr) {
  return jsonStr.replace(
    /("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g,
    (match) => {
      let cls = colors.yellow; // números
      if (/^"/.test(match)) {
        if (/:$/.test(match)) {
          cls = colors.cyan; // clave
        } else {
          cls = colors.green; // string
        }
      } else if (/true|false/.test(match)) {
        cls = colors.magenta; // boolean
      } else if (/null/.test(match)) {
        cls = colors.gray; // null
      }
      return `${cls}${match}${colors.reset}`;
    }
  );
}

// --- PARSER DE ARGUMENTOS ---
function parseArgs(args) {
  const result = {
    flags: {},
    positional: [],
  };

  let i = 0;
  while (i < args.length) {
    const arg = args[i];

    if (arg.startsWith('--')) {
      const key = arg.slice(2);
      if (key.includes('=')) {
        const [k, v] = key.split('=', 2);
        result.flags[k] = v;
      } else if (i + 1 < args.length && !args[i + 1].startsWith('-')) {
        result.flags[key] = args[i + 1];
        i++;
      } else {
        result.flags[key] = true;
      }
    } else if (arg.startsWith('-')) {
      const key = arg.slice(1);
      if (key === 'q') {
        result.flags['raw-json'] = true;
      } else if (key === 'h') {
        result.flags['help'] = true;
      } else if (key === 'v') {
        result.flags['version'] = true;
      } else if (i + 1 < args.length && !args[i + 1].startsWith('-')) {
        result.flags[key] = args[i + 1];
        i++;
      } else {
        result.flags[key] = true;
      }
    } else {
      if (!result.resource) {
        result.resource = arg;
      } else if (!result.action) {
        result.action = arg;
      } else {
        result.positional.push(arg);
      }
    }
    i++;
  }

  return result;
}

// --- CLIENTE HTTP ---
async function requestHttp(method, path, options = {}) {
  const baseUrl = options.baseUrl || DEFAULT_BASE_URL;
  const cleanBase = baseUrl.replace(/\/$/, '');
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  const fullUrl = `${cleanBase}${cleanPath}`;

  const headers = {
    Accept: 'application/json',
    ...(options.headers || {}),
  };

  let bodyStr = undefined;
  if (options.body !== undefined) {
    headers['Content-Type'] = headers['Content-Type'] || 'application/json';
    bodyStr = typeof options.body === 'string' ? options.body : JSON.stringify(options.body);
  }

  const start = performance.now();
  const response = await fetch(fullUrl, {
    method,
    headers,
    body: bodyStr,
  });
  const latencyMs = Math.round(performance.now() - start);

  const contentType = response.headers.get('content-type') || '';
  let data = null;
  if (contentType.includes('application/json')) {
    data = await response.json();
  } else {
    data = await response.text();
  }

  const setCookie = response.headers.get('set-cookie');

  return {
    status: response.status,
    statusText: response.statusText,
    headers: response.headers,
    setCookie,
    data,
    latencyMs,
    url: fullUrl,
    method,
  };
}

// Formateador de salida
function renderResponse(res, rawJson) {
  if (rawJson) {
    if (typeof res.data === 'object' && res.data !== null) {
      console.log(JSON.stringify(res.data, null, 2));
    } else {
      console.log(res.data);
    }
    if (res.status >= 400) {
      process.exitCode = 1;
    }
    return;
  }

  const isSuccess = res.status >= 200 && res.status < 300;
  const statusColor = isSuccess ? colors.green : colors.red;
  const methodColor = colors.bold + colors.cyan;

  console.log(
    `${statusColor}HTTP/1.1 ${res.status} ${res.statusText}${colors.reset} ${colors.gray}[${res.latencyMs}ms]${colors.reset}`
  );
  console.log(`${methodColor}${res.method}${colors.reset} ${colors.dim}${res.url}${colors.reset}\n`);

  if (typeof res.data === 'object' && res.data !== null) {
    const jsonStr = JSON.stringify(res.data, null, 2);
    console.log(highlightJson(jsonStr));
  } else if (res.data) {
    console.log(res.data);
  }

  if (res.status >= 400) {
    process.exitCode = 1;
  }
}

// --- MENÚS DE AYUDA ---
function printGeneralHelp() {
  console.log(`${colors.bold}AngelPixel Identity CLI${colors.reset} v${VERSION}
Uso: identity <recurso> <accion> [banderas]

${colors.bold}Recursos Disponibles:${colors.reset}
  ${colors.cyan}auth${colors.reset}         Gestión de usuarios y autenticación (register, me, update-user)
  ${colors.cyan}client${colors.reset}       Gobernanza y validación de clientes OAuth2 (validate)
  ${colors.cyan}token${colors.reset}        Emisión y canje de tokens OAuth2 (m2m, exchange)
  ${colors.cyan}oidc${colors.reset}         Protocolo OpenID Connect (discovery, jwks, authorize)
  ${colors.cyan}session${colors.reset}      Gestión de sesiones y rotación de Refresh Tokens (refresh, revoke)
  ${colors.cyan}federation${colors.reset}   Federación de identidad OIDC externa (login, callback)

${colors.bold}Opciones Globales:${colors.reset}
  --base-url <url>    URL de la API (def: http://localhost:4000 o $IDENTITY_API_URL)
  -q, --raw-json      Imprime exclusivamente JSON plano sin metadatos ni colores
  -h, --help          Muestra este mensaje de ayuda
  -v, --version       Muestra la versión de la CLI

${colors.bold}Ejemplos:${colors.reset}
  identity auth register --tenant acme-corp --email user@acme.com --password "Secret2026!"
  identity auth me --tenant acme-corp --token "$TOKEN"
  identity auth update-user --tenant acme-corp --token "$TOKEN" --user-id "$USER_ID" --name "Nuevo Nombre"
  identity client validate --client-id portal-web --origin https://portal.angelpixel.io
  identity token m2m --client-id m2m-service-app --client-secret "$SECRET"
  identity token exchange --client-id portal-web --redirect-uri https://portal.angelpixel.io/callback --code "$CODE" --verifier "$VERIFIER"
  identity oidc discovery
  identity oidc jwks
  identity oidc authorize --client-id portal-web --redirect-uri https://portal.angelpixel.io/callback
  identity session refresh --token "$REFRESH_TOKEN"
  identity session revoke --token "$REFRESH_TOKEN"
  identity federation login --provider google --tenant acme-corp --redirect-uri https://portal.angelpixel.io/callback
  identity federation callback --provider google --code "dev_google_jit_2026" --state "$STATE"
`);
}

function printAuthHelp() {
  console.log(`${colors.bold}Uso: identity auth <accion> [banderas]${colors.reset}

${colors.bold}Acciones:${colors.reset}
  ${colors.cyan}register${colors.reset}     Registra un nuevo usuario en la organización
               Banderas:
                 --tenant <id>       ID del inquilino (Requerido)
                 --email <email>     Correo electrónico (Requerido)
                 --password <pwd>    Contraseña (Requerido)
                 --name <name>       Nombre completo (Opcional)

  ${colors.cyan}me${colors.reset}           Consulta el perfil del usuario autenticado (Cache-Aside)
               Banderas:
                 --tenant <id>       ID del inquilino (Requerido)
                 --token <jwt>       Token de acceso Bearer (Requerido)

  ${colors.cyan}update-user${colors.reset}  Actualiza atributos de un usuario por ID (Sujeto a guardia RLS y Cross-Tenant)
               Banderas:
                 --tenant <id>       ID del inquilino (Requerido)
                 --token <jwt>       Token de acceso Bearer (Requerido)
                 --user-id <uuid>    ID del usuario objetivo (Requerido)
                 --name <name>       Nuevo nombre a aplicar (Opcional)

${colors.bold}Ejemplos:${colors.reset}
  identity auth register --tenant acme-corp --email dev@acme.com --password "EnterprisePassword2026!"
  identity auth me --tenant acme-corp --token eyJhbGciOi...
  identity auth update-user --tenant acme-corp --token "$TOKEN" --user-id 4476ffac-2423-444b-8342-efbfe4dbaeba --name "Mutacion"
`);
}

// --- MANEJADOR DEL DOMINIO AUTH ---
async function handleAuthDomain(action, flags, baseUrl, rawJson) {
  if (!action || flags.help || flags.h) {
    printAuthHelp();
    return;
  }

  if (action === 'register') {
    const tenant = flags.tenant || flags['tenant-id'] || flags.t;
    const email = flags.email || flags.e;
    const password = flags.password || flags.p;
    const name = flags.name || flags.n;

    if (!tenant) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --tenant es obligatoria para registrar un usuario.`);
      process.exit(1);
    }
    if (!email) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --email es obligatoria para registrar un usuario.`);
      process.exit(1);
    }
    if (!password) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --password es obligatoria para registrar un usuario.`);
      process.exit(1);
    }

    const payload = { email, password };
    if (name) payload.name = name;

    const res = await requestHttp('POST', '/api/v1/auth/register', {
      baseUrl,
      headers: {
        'X-Tenant-ID': String(tenant),
      },
      body: payload,
    });

    renderResponse(res, rawJson);
    return;
  }

  if (action === 'me') {
    const tenant = flags.tenant || flags['tenant-id'] || flags.t;
    const token = flags.token;

    if (!tenant) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --tenant es obligatoria para consultar el perfil.`);
      process.exit(1);
    }
    if (!token) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --token es obligatoria para consultar el perfil.`);
      process.exit(1);
    }

    const res = await requestHttp('GET', '/api/v1/auth/me', {
      baseUrl,
      headers: {
        'X-Tenant-ID': String(tenant),
        Authorization: `Bearer ${String(token).replace(/^Bearer\s+/i, '')}`,
      },
    });

    renderResponse(res, rawJson);
    return;
  }

  if (action === 'update-user') {
    const tenant = flags.tenant || flags['tenant-id'] || flags.t;
    const token = flags.token;
    const userId = flags['user-id'] || flags.id || flags.u;
    const name = flags.name || flags.n;

    if (!tenant) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --tenant es obligatoria para actualizar un usuario.`);
      process.exit(1);
    }
    if (!token) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --token es obligatoria para actualizar un usuario.`);
      process.exit(1);
    }
    if (!userId) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --user-id es obligatoria para actualizar un usuario.`);
      process.exit(1);
    }

    const res = await requestHttp('PATCH', `/api/v1/users/${encodeURIComponent(String(userId))}`, {
      baseUrl,
      headers: {
        'X-Tenant-ID': String(tenant),
        Authorization: `Bearer ${String(token).replace(/^Bearer\s+/i, '')}`,
      },
      body: { name: name ? String(name) : 'Updated User' },
    });

    renderResponse(res, rawJson);
    return;
  }

  console.error(`${colors.red}Acción desconocida:${colors.reset} "${action}" para el recurso auth. Usa --help para ver las acciones disponibles.`);
  process.exit(1);
}

function printClientHelp() {
  console.log(`${colors.bold}Uso: identity client <accion> [banderas]${colors.reset}

${colors.bold}Acciones:${colors.reset}
  ${colors.cyan}validate${colors.reset}    Valida que una aplicación cliente exista, esté activa y tenga autorizado el origen web (CORS)
              Banderas:
                -c, --client-id <id>     ID de la aplicación cliente (Requerido)
                -o, --origin <url>       Origen HTTP que realiza la solicitud (Requerido)

${colors.bold}Ejemplos:${colors.reset}
  identity client validate --client-id portal-web --origin https://portal.angelpixel.io
  identity client validate -c m2m-service-app -o https://m2m.worker.local
`);
}

// --- MANEJADOR DEL DOMINIO CLIENT ---
async function handleClientDomain(action, flags, baseUrl, rawJson) {
  if (!action || flags.help || flags.h) {
    printClientHelp();
    return;
  }

  if (action === 'validate') {
    const clientId = flags['client-id'] || flags.c;
    const origin = flags.origin || flags.o;

    if (!clientId) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --client-id (-c) es obligatoria para validar un cliente.`);
      process.exit(1);
    }
    if (!origin) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --origin (-o) es obligatoria para validar el origen del cliente.`);
      process.exit(1);
    }

    const res = await requestHttp('POST', '/api/v1/oauth2/clients/validate', {
      baseUrl,
      headers: {
        Origin: String(origin),
        'X-Client-ID': String(clientId),
      },
      body: {
        clientId: String(clientId),
      },
    });

    renderResponse(res, rawJson);
    return;
  }

  console.error(`${colors.red}Acción desconocida:${colors.reset} "${action}" para el recurso client. Usa --help para ver las acciones disponibles.`);
  process.exit(1);
}

function printTokenHelp() {
  console.log(`${colors.bold}Uso: identity token <accion> [banderas]${colors.reset}

${colors.bold}Acciones:${colors.reset}
  ${colors.cyan}m2m${colors.reset}         Emite un Access Token para un cliente confidencial M2M (RFC 6749 Secc. 4.4)
              Banderas:
                -c, --client-id <id>        ID del cliente confidencial (Requerido)
                -s, --client-secret <sec>   Secreto del cliente (Requerido)
                --scope <scopes>            Ámbitos OAuth2 solicitados (Opcional)
                --auth-mode <basic|json>    Modo de envío de credenciales: json (defecto) o basic

  ${colors.cyan}exchange${colors.reset}    Canjea un código de autorización por tokens OIDC con PKCE (RFC 7636)
              Banderas:
                -c, --client-id <id>        ID del cliente público (Requerido)
                -r, --redirect-uri <uri>    URI de redirección exacta (Requerido)
                --code <code>               Código de autorización OIDC (Requerido)
                -v, --verifier <str>        Verificador PKCE de alta entropía (Requerido)

${colors.bold}Ejemplos:${colors.reset}
  identity token m2m --client-id m2m-service-app --client-secret "ValidSecret123!"
  identity token m2m -c m2m-service-app -s "ValidSecret123!" --auth-mode basic
  identity token exchange -c portal-web -r https://portal.angelpixel.io/callback --code auth_code_123 --verifier "dBjftJeZ4C..."
`);
}

// --- MANEJADOR DEL DOMINIO TOKEN ---
async function handleTokenDomain(action, flags, baseUrl, rawJson) {
  if (!action || flags.help || flags.h) {
    printTokenHelp();
    return;
  }

  if (action === 'm2m') {
    const clientId = flags['client-id'] || flags.c;
    const clientSecret = flags['client-secret'] || flags.s;
    const scope = flags.scope;
    const authMode = (flags['auth-mode'] || 'json').toLowerCase();

    if (!clientId) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --client-id (-c) es obligatoria para emitir un token M2M.`);
      process.exit(1);
    }
    if (!clientSecret) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --client-secret (-s) es obligatoria para emitir un token M2M.`);
      process.exit(1);
    }

    const headers = {};
    const body = {
      grant_type: 'client_credentials',
    };
    if (scope) body.scope = String(scope);

    if (authMode === 'basic') {
      const basicCredentials = Buffer.from(`${clientId}:${clientSecret}`).toString('base64');
      headers.Authorization = `Basic ${basicCredentials}`;
    } else {
      body.client_id = String(clientId);
      body.client_secret = String(clientSecret);
    }

    const res = await requestHttp('POST', '/api/v1/oauth2/token', {
      baseUrl,
      headers,
      body,
    });

    renderResponse(res, rawJson);
    return;
  }

  if (action === 'exchange') {
    const clientId = flags['client-id'] || flags.c;
    const redirectUri = flags['redirect-uri'] || flags.r;
    const code = flags.code;
    const verifier = flags.verifier || flags.v;

    if (!clientId) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --client-id (-c) es obligatoria para el canje de código.`);
      process.exit(1);
    }
    if (!redirectUri) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --redirect-uri (-r) es obligatoria para el canje de código.`);
      process.exit(1);
    }
    if (!code) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --code es obligatoria para el canje de código.`);
      process.exit(1);
    }
    if (!verifier) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --verifier (-v) es obligatoria para el canje de código PKCE.`);
      process.exit(1);
    }

    const body = {
      grant_type: 'authorization_code',
      client_id: String(clientId),
      redirect_uri: String(redirectUri),
      code: String(code),
      code_verifier: String(verifier),
    };

    const res = await requestHttp('POST', '/api/v1/oauth2/token', {
      baseUrl,
      body,
    });

    renderResponse(res, rawJson);
    return;
  }

  console.error(`${colors.red}Acción desconocida:${colors.reset} "${action}" para el recurso token. Usa --help para ver las acciones disponibles.`);
  process.exit(1);
}

function printOidcHelp() {
  console.log(`${colors.bold}Uso: identity oidc <accion> [banderas]${colors.reset}

${colors.bold}Acciones:${colors.reset}
  ${colors.cyan}discovery${colors.reset}   Consulta el documento canónico de metadatos OIDC (RFC 8414)
              Endpoint: /.well-known/openid-configuration

  ${colors.cyan}jwks${colors.reset}        Consulta el set de claves criptográficas públicas RSA (RFC 7517)
              Endpoint: /.well-known/jwks.json

  ${colors.cyan}authorize${colors.reset}   Inicia el flujo interactivo de autorización con soporte PKCE (RFC 7636)
              Banderas:
                -c, --client-id <id>        ID del cliente público (Requerido)
                -r, --redirect-uri <uri>    URI de redirección exacta (Requerido)
                --scope <scopes>            Ámbitos OIDC solicitados (def: openid profile email)
                --state <state>             Valor de estado de seguridad (Opcional, def: auto-generado)
                --challenge <str>           Desafío de código PKCE (Opcional, def: auto-generado con S256)
                --challenge-method <method> Método de desafío PKCE: S256 (defecto) o plain

${colors.bold}Ejemplos:${colors.reset}
  identity oidc discovery
  identity oidc discovery --raw-json | jq -r .jwks_uri
  identity oidc jwks
  identity oidc authorize --client-id portal-web --redirect-uri https://portal.angelpixel.io/callback
  identity oidc authorize -c portal-web -r https://portal.angelpixel.io/callback --scope "openid profile"
`);
}

// --- MANEJADOR DEL DOMINIO OIDC ---
async function handleOidcDomain(action, flags, baseUrl, rawJson) {
  if (!action || flags.help || flags.h) {
    printOidcHelp();
    return;
  }

  if (action === 'discovery') {
    const res = await requestHttp('GET', '/.well-known/openid-configuration', {
      baseUrl,
    });
    renderResponse(res, rawJson);
    return;
  }

  if (action === 'jwks') {
    const res = await requestHttp('GET', '/.well-known/jwks.json', {
      baseUrl,
    });
    renderResponse(res, rawJson);
    return;
  }

  if (action === 'authorize') {
    const clientId = flags['client-id'] || flags.c;
    const redirectUri = flags['redirect-uri'] || flags.r;
    const scope = flags.scope || 'openid profile email';
    const state = flags.state || `state_${crypto.randomBytes(8).toString('hex')}`;
    let challenge = flags.challenge;
    const challengeMethod = flags['challenge-method'] || 'S256';
    let codeVerifier = undefined;

    if (!clientId) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --client-id (-c) es obligatoria para iniciar autorización.`);
      process.exit(1);
    }
    if (!redirectUri) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --redirect-uri (-r) es obligatoria para iniciar autorización.`);
      process.exit(1);
    }

    if (!challenge) {
      // Auto-generación criptográfica de PKCE RFC 7636
      codeVerifier = crypto.randomBytes(32).toString('base64url');
      challenge = crypto.createHash('sha256').update(codeVerifier).digest('base64url');
    }

    const body = {
      client_id: String(clientId),
      redirect_uri: String(redirectUri),
      response_type: 'code',
      scope: String(scope),
      state: String(state),
      code_challenge: String(challenge),
      code_challenge_method: String(challengeMethod),
    };

    const res = await requestHttp('POST', '/api/v1/oauth2/authorize', {
      baseUrl,
      headers: {
        Accept: 'application/json',
      },
      body,
    });

    if (res.status >= 200 && res.status < 300 && codeVerifier && typeof res.data === 'object' && res.data !== null) {
      // Inyectar code_verifier para facilitar la composición y encadenamiento con token exchange
      res.data.code_verifier = codeVerifier;
    }

    renderResponse(res, rawJson);
    return;
  }

  console.error(`${colors.red}Acción desconocida:${colors.reset} "${action}" para el recurso oidc. Usa --help para ver las acciones disponibles.`);
  process.exit(1);
}

function printSessionHelp() {
  console.log(`${colors.bold}Uso: identity session <accion> [banderas]${colors.reset}

${colors.bold}Acciones:${colors.reset}
  ${colors.cyan}refresh${colors.reset}     Ejecuta la rotación 1 a 1 del Refresh Token y renueva el Access Token (RFC 6749 §6)
              Banderas:
                -t, --token <token>         Token de refresco activo (Requerido)
                -c, --client-id <id>        ID del cliente asociado (Opcional)

  ${colors.cyan}revoke${colors.reset}      Revoca una sesión activa y todas las credenciales de su familia (RFC 7009)
              Banderas:
                -t, --token <token>         Token de refresco a revocar (Requerido)
                --reason <str>              Razón de revocación (Opcional, def: user_logout)

${colors.bold}Ejemplos:${colors.reset}
  identity session refresh --token "seed_refresh_token_portal_web_dev_2026" --client-id portal-web
  identity session refresh -t "$REFRESH_TOKEN"
  identity session revoke --token "$REFRESH_TOKEN" --reason "user_logout"
`);
}

// --- MANEJADOR DEL DOMINIO SESSION ---
async function handleSessionDomain(action, flags, baseUrl, rawJson) {
  if (!action || flags.help || flags.h) {
    printSessionHelp();
    return;
  }

  if (action === 'refresh') {
    const token = flags.token || flags.t || flags['refresh-token'] || flags.r;
    const clientId = flags['client-id'] || flags.c;

    if (!token) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --token (-t) es obligatoria para renovar la sesión.`);
      process.exit(1);
    }

    const body = {
      refresh_token: String(token),
    };
    if (clientId) {
      body.client_id = String(clientId);
    }

    const res = await requestHttp('POST', '/api/v1/oauth2/refresh', {
      baseUrl,
      body,
    });

    // Extraer new_refresh_token de la cookie Set-Cookie si existe
    if (res.status >= 200 && res.status < 300 && res.setCookie && typeof res.data === 'object' && res.data !== null) {
      const match = res.setCookie.match(/refresh_token=([^;]+)/i);
      if (match && match[1]) {
        res.data.new_refresh_token = match[1];
      }
    }

    renderResponse(res, rawJson);
    return;
  }

  if (action === 'revoke') {
    const token = flags.token || flags.t || flags['refresh-token'] || flags.r;
    const reason = flags.reason || 'user_logout';

    if (!token) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --token (-t) es obligatoria para revocar la sesión.`);
      process.exit(1);
    }

    const body = {
      refresh_token: String(token),
      reason: String(reason),
    };

    const res = await requestHttp('POST', '/api/v1/oauth2/revoke', {
      baseUrl,
      body,
    });

    renderResponse(res, rawJson);
    return;
  }

  console.error(`${colors.red}Acción desconocida:${colors.reset} "${action}" para el recurso session. Usa --help para ver las acciones disponibles.`);
  process.exit(1);
}

function printFederationHelp() {
  console.log(`${colors.bold}Uso: identity federation <accion> [banderas]${colors.reset}

${colors.bold}Acciones:${colors.reset}
  ${colors.cyan}login${colors.reset}       Genera la URL de autorización OIDC externa con State HMAC-SHA256 y Nonce (US-10)
              Banderas:
                -p, --provider <id>         Proveedor OIDC: google | microsoft (Requerido)
                -t, --tenant <id>           ID del inquilino (Requerido)
                -r, --redirect-uri <uri>    URI de redirección autorizada (Requerido)
                -c, --client-id <id>        ID del cliente OAuth2 (Opcional)
                --login-hint <email>        Sugerencia de correo de inicio de sesión (Opcional)

  ${colors.cyan}callback${colors.reset}    Procesa el callback OIDC externo, vincula cuenta o aprovisiona usuario JIT (US-11)
              Banderas:
                -p, --provider <id>         Proveedor OIDC: google | microsoft (Requerido)
                --code <code>               Código de autorización externo o código dev_* (Requerido)
                --state <state>             Token state firmado anti-CSRF (Requerido)

${colors.bold}Ejemplos:${colors.reset}
  identity federation login --provider google --tenant acme-corp --client-id portal-web --redirect-uri https://portal.angelpixel.io/callback
  identity federation login -p microsoft -t acme-corp -r https://portal.angelpixel.io/callback
  identity federation callback --provider google --code "dev_google_jit_2026" --state "$STATE"
  identity federation callback --provider google --code "dev_google_link_2026" --state "$STATE"
`);
}

// --- MANEJADOR DEL DOMINIO FEDERATION ---
async function handleFederationDomain(action, flags, baseUrl, rawJson) {
  if (!action || flags.help || flags.h) {
    printFederationHelp();
    return;
  }

  if (action === 'login') {
    const provider = flags.provider || flags.p;
    const tenantId = flags.tenant || flags['tenant-id'] || flags.t;
    const redirectUri = flags['redirect-uri'] || flags.r;
    const clientId = flags['client-id'] || flags.c;
    const loginHint = flags['login-hint'];
    const prompt = flags.prompt;

    if (!provider) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --provider (-p) es obligatoria (google | microsoft).`);
      process.exit(1);
    }
    if (!tenantId) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --tenant (-t) es obligatoria.`);
      process.exit(1);
    }
    if (!redirectUri) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --redirect-uri (-r) es obligatoria.`);
      process.exit(1);
    }

    const qs = new URLSearchParams({
      tenant_id: String(tenantId),
      redirect_uri: String(redirectUri),
      format: 'json',
    });
    if (clientId) qs.set('client_id', String(clientId));
    if (loginHint) qs.set('login_hint', String(loginHint));
    if (prompt) qs.set('prompt', String(prompt));

    const res = await requestHttp(
      'GET',
      `/api/v1/auth/federation/${encodeURIComponent(String(provider))}/login?${qs.toString()}`,
      { baseUrl }
    );

    renderResponse(res, rawJson);
    return;
  }

  if (action === 'callback') {
    const provider = flags.provider || flags.p;
    const code = flags.code;
    const state = flags.state;

    if (!provider) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --provider (-p) es obligatoria (google | microsoft).`);
      process.exit(1);
    }
    if (!code) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --code es obligatoria.`);
      process.exit(1);
    }
    if (!state) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --state es obligatoria.`);
      process.exit(1);
    }

    const res = await requestHttp(
      'POST',
      `/api/v1/auth/federation/${encodeURIComponent(String(provider))}/callback`,
      {
        baseUrl,
        body: {
          code: String(code),
          state: String(state),
        },
      }
    );

    renderResponse(res, rawJson);
    return;
  }

  console.error(`${colors.red}Acción desconocida:${colors.reset} "${action}" para el recurso federation. Usa --help para ver las acciones disponibles.`);
  process.exit(1);
}

// --- FUNCIÓN PRINCIPAL (ENTRYPOINT) ---
async function main() {
  const parsed = parseArgs(process.argv.slice(2));
  const baseUrl = parsed.flags['base-url'] || DEFAULT_BASE_URL;
  const rawJson = Boolean(parsed.flags['raw-json'] || parsed.flags.q);

  if (parsed.flags.version || parsed.flags.v) {
    console.log(`v${VERSION}`);
    return;
  }

  if (!parsed.resource) {
    printGeneralHelp();
    return;
  }

  switch (parsed.resource) {
    case 'auth':
      await handleAuthDomain(parsed.action, parsed.flags, baseUrl, rawJson);
      break;

    case 'client':
      await handleClientDomain(parsed.action, parsed.flags, baseUrl, rawJson);
      break;

    case 'token':
      await handleTokenDomain(parsed.action, parsed.flags, baseUrl, rawJson);
      break;

    case 'oidc':
      await handleOidcDomain(parsed.action, parsed.flags, baseUrl, rawJson);
      break;

    case 'session':
      await handleSessionDomain(parsed.action, parsed.flags, baseUrl, rawJson);
      break;

    case 'federation':
      await handleFederationDomain(parsed.action, parsed.flags, baseUrl, rawJson);
      break;

    default:
      console.error(`${colors.red}Recurso desconocido:${colors.reset} "${parsed.resource}". Usa --help para ver los recursos disponibles.`);
      process.exit(1);
  }
}

main().catch((err) => {
  console.error(`${colors.red}Error fatal de ejecución:${colors.reset}`, err.message || err);
  process.exit(1);
});

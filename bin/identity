// --- MANEJADOR DEL DOMINIO FEDERATION ---
async function handleFederationDomain(action, flags, baseUrl, rawJson) {
  if (!action || flags.help || flags.h) {
    printFederationHelp();
    return;
  }

  if (action === 'login') {
    const provider = flags.provider || flags.p;
    const tenantId = flags.tenant || flags['tenant-id'] || flags.t;
    const redirectUri = flags['redirect-uri'] || flags.r;
    const clientId = flags['client-id'] || flags.c;
    const loginHint = flags['login-hint'];
    const prompt = flags.prompt;

    if (!provider) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --provider (-p) es obligatoria (google | microsoft).`);
      process.exit(1);
    }
    if (!tenantId) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --tenant (-t) es obligatoria.`);
      process.exit(1);
    }
    if (!redirectUri) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --redirect-uri (-r) es obligatoria.`);
      process.exit(1);
    }

    const qs = new URLSearchParams({
      tenant_id: String(tenantId),
      redirect_uri: String(redirectUri),
      format: 'json',
    });
    if (clientId) qs.set('client_id', String(clientId));
    if (loginHint) qs.set('login_hint', String(loginHint));
    if (prompt) qs.set('prompt', String(prompt));

    const res = await requestHttp(
      'GET',
      `/api/v1/auth/federation/${encodeURIComponent(String(provider))}/login?${qs.toString()}`,
      { baseUrl }
    );

    renderResponse(res, rawJson);
    return;
  }

  if (action === 'callback') {
    const provider = flags.provider || flags.p;
    const code = flags.code;
    const state = flags.state;

    if (!provider) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --provider (-p) es obligatoria (google | microsoft).`);
      process.exit(1);
    }
    if (!code) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --code es obligatoria.`);
      process.exit(1);
    }
    if (!state) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --state es obligatoria.`);
      process.exit(1);
    }

    const res = await requestHttp(
      'POST',
      `/api/v1/auth/federation/${encodeURIComponent(String(provider))}/callback`,
      {
        baseUrl,
        body: {
          code: String(code),
          state: String(state),
        },
      }
    );

    renderResponse(res, rawJson);
    return;
  }

  console.error(`${colors.red}Acción desconocida:${colors.reset} "${action}" para el recurso federation. Usa --help para ver las acciones disponibles.`);
  process.exit(1);
}

// --- MENÚ DE AYUDA DEL DOMINIO AUDIT ---
function printAuditHelp() {
  console.log(`${colors.bold}Uso: identity audit <accion> [banderas]${colors.reset}

${colors.bold}Acciones de Auditoría Estructurada de Seguridad (US-19 & ADR-0009):${colors.reset}
  ${colors.cyan}events${colors.reset}       Consulta y exporta en vivo eventos canónicos de auditoría (GET /api/v1/audit/events)
               Requiere operador del Root Tenant ('system' + rol 'superadmin').
               Banderas:
                 --token <jwt>              JWT de operador Root Superadmin (Requerido)
                 --tenant <id>              Filtrar por espacio de tenencia (Opcional)
                 --severity <nivel>         Filtrar por severidad: INFO | WARN | ERROR | ALERT | CRITICAL (Opcional)
                 --event-type <tipo>        Filtrar por tipo de evento canónico (Opcional)
                 --limit <n>                Límite de registros a retornar, 1..200 (def: 20)
                 --format <tipo>            Formato de salida: json | ndjson | table (def: json)

${colors.bold}Ejemplos:${colors.reset}
  identity audit events --token "$ROOT_TOKEN"
  identity audit events --token "$ROOT_TOKEN" --severity ALERT --format ndjson
  identity audit events --token "$ROOT_TOKEN" --tenant alpha-corp --limit 10 --format table
`);
}

// --- MANEJADOR DEL DOMINIO AUDIT ---
async function handleAuditDomain(action, flags, baseUrl, rawJson) {
  if (!action || flags.help || flags.h) {
    printAuditHelp();
    return;
  }

  if (action === 'events') {
    const token = flags.token || flags.t;
    if (!token) {
      console.error(`${colors.red}Error:${colors.reset} Se requiere --token <jwt> de un operador Root Superadmin ('system').`);
      process.exit(1);
    }

    const format = String(flags.format || 'json').toLowerCase();
    if (!['json', 'ndjson', 'table'].includes(format)) {
      console.error(`${colors.red}Error:${colors.reset} Formato inválido "${format}". Usa: json | ndjson | table.`);
      process.exit(1);
    }

    const params = new URLSearchParams();
    if (flags.tenant) params.set('tenantId', String(flags.tenant));
    if (flags.severity || flags.s) params.set('severity', String(flags.severity || flags.s).toUpperCase());
    if (flags['event-type']) params.set('eventType', String(flags['event-type']).toUpperCase());
    params.set('limit', String(flags.limit || '20'));
    params.set('format', format === 'ndjson' ? 'ndjson' : 'json');

    const res = await requestHttp('GET', `/api/v1/audit/events?${params.toString()}`, {
      baseUrl,
      headers: {
        Authorization: `Bearer ${token}`,
        Accept: format === 'ndjson' ? 'application/x-ndjson, application/json' : 'application/json',
      },
    });

    if (res.status !== 200) {
      renderResponse(res, rawJson);
      return;
    }

    if (format === 'ndjson') {
      const text = typeof res.data === 'string' ? res.data.trimEnd() : '';
      if (text) {
        console.log(text);
      }
      return;
    }

    if (format === 'table' && !rawJson) {
      const events = Array.isArray(res.data?.events) ? res.data.events : [];
      console.log(`\n${colors.bold}REGISTROS DE AUDITORÍA DE SEGURIDAD EN VIVO (US-19 — WORM COMPLIANCE):${colors.reset}`);
      console.log(`${colors.dim}-------------------------------------------------------------------------------------------------------${colors.reset}`);
      console.log(`${colors.bold}${'TIMESTAMP (UTC)'.padEnd(25)} ${'EVENT TYPE'.padEnd(28)} ${'SEVERITY'.padEnd(10)} ${'TENANT'.padEnd(14)} ${'STATUS'.padEnd(9)} ${'PCI-REQ'}${colors.reset}`);
      console.log(`${colors.dim}-------------------------------------------------------------------------------------------------------${colors.reset}`);
      for (const ev of events) {
        let sevColor = colors.green;
        if (ev.severity === 'ALERT' || ev.severity === 'CRITICAL') sevColor = colors.red;
        else if (ev.severity === 'WARN') sevColor = colors.yellow;

        console.log(
          `${colors.dim}${String(ev.timestamp || '').padEnd(25)}${colors.reset} ` +
          `${colors.cyan}${String(ev.eventType || '').padEnd(28)}${colors.reset} ` +
          `${sevColor}${String(ev.severity || '').padEnd(10)}${colors.reset} ` +
          `${String(ev.tenantId || '-').padEnd(14)} ` +
          `${String(ev.status || '').padEnd(9)} ` +
          `${colors.magenta}${String(ev.compliance?.pciRequirement || '-')}${colors.reset}`
        );
      }
      console.log(`${colors.dim}-------------------------------------------------------------------------------------------------------${colors.reset}`);
      console.log(`${colors.green}✓ ${events.length} evento(s) real(es) recuperado(s) del proceso. Retención WORM en Azure Log Analytics: 365 días.${colors.reset}\n`);
      return;
    }

    renderResponse(res, rawJson);
    return;
  }

  console.error(`${colors.red}Acción desconocida:${colors.reset} "${action}" para el recurso audit. Usa --help para ver las acciones disponibles.`);
  process.exit(1);
}

// --- MENÚ DE AYUDA DEL DOMINIO OPS ---
function printOpsHelp() {
  console.log(`${colors.bold}Uso: identity ops <accion> [banderas]${colors.reset}

${colors.bold}Acciones Operacionales & Observabilidad:${colors.reset}
  ${colors.cyan}metrics${colors.reset}          Inspecciona y filtra métricas Prometheus expuestas en tiempo real (US-21)
                   Banderas:
                     --filter <texto>           Filtra líneas o métricas por subcadena o expresión regular
                     --format <tipo>            Formato de salida: prometheus | json (def: prometheus)

  ${colors.cyan}reseed-dev-sessions${colors.reset}  Re-siembra en caliente la sesión de refresco de desarrollo (portal-web)

  ${colors.cyan}db-reset${colors.reset}             Reinicia por completo la base de datos PostgreSQL y purga la caché Redis
                   Banderas:
                     --no-seeds                 Omite la inserción de clientes iniciales de desarrollo

${colors.bold}Ejemplos:${colors.reset}
  identity ops metrics --filter http_requests
  identity ops metrics --filter target_info --format json
  identity ops reseed-dev-sessions
  identity ops reseed-dev-sessions --raw-json
  identity ops db-reset
  identity ops db-reset --no-seeds
  identity ops db-reset --raw-json
`);
}

// --- MANEJADOR DEL DOMINIO OPS ---
async function handleOpsDomain(action, flags, baseUrl, rawJson) {
  if (!action || flags.help || flags.h) {
    printOpsHelp();
    return;
  }

  if (action === 'metrics') {
    const filter = flags.filter || flags.f;
    const format = String(flags.format || 'prometheus').toLowerCase();

    const res = await requestHttp('GET', '/metrics', { baseUrl });

    if (res.status !== 200) {
      renderResponse(res, rawJson);
      return;
    }

    const rawText = typeof res.data === 'string' ? res.data : JSON.stringify(res.data);
    const lines = rawText.split('\n');

    let matchingLines = lines;
    if (filter) {
      const reg = new RegExp(String(filter), 'i');
      matchingLines = lines.filter((line) => reg.test(line));
    }

    if (format === 'json') {
      const metricsObj = {};
      for (const line of matchingLines) {
        const trimmed = line.trim();
        if (!trimmed || trimmed.startsWith('#')) continue;
        const spaceIdx = trimmed.lastIndexOf(' ');
        if (spaceIdx > 0) {
          const key = trimmed.slice(0, spaceIdx);
          const val = parseFloat(trimmed.slice(spaceIdx + 1));
          metricsObj[key] = isNaN(val) ? trimmed.slice(spaceIdx + 1) : val;
        }
      }

      if (rawJson) {
        console.log(JSON.stringify(metricsObj));
      } else {
        console.log(highlightJson(JSON.stringify(metricsObj, null, 2)));
      }
      return;
    }

    // Formato prometheus por defecto
    if (rawJson) {
      console.log(matchingLines.join('\n'));
    } else {
      console.log(`${colors.bold}Métricas Prometheus (${matchingLines.length} líneas encontradas):${colors.reset}`);
      for (const l of matchingLines) {
        if (l.startsWith('# HELP')) {
          console.log(`${colors.cyan}${l}${colors.reset}`);
        } else if (l.startsWith('# TYPE') || l.startsWith('# UNIT')) {
          console.log(`${colors.gray}${l}${colors.reset}`);
        } else if (l.trim()) {
          console.log(`${colors.green}${l}${colors.reset}`);
        } else {
          console.log('');
        }
      }
    }
    return;
  }

  if (action === 'reseed-dev-sessions') {
    const res = await requestHttp('POST', '/api/v1/ops/reseed-dev-sessions', {
      baseUrl,
    });
    renderResponse(res, rawJson);
    return;
  }

  if (action === 'db-reset') {
    const noSeeds = Boolean(flags['no-seeds']);
    const { spawnSync } = await import('child_process');
    const path = await import('path');
    const { fileURLToPath } = await import('url');
    const scriptPath = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../scripts/db-reset.ts');

    const args = [scriptPath];
    if (noSeeds) args.push('--no-seeds');
    if (rawJson) args.push('--quiet');

    const result = spawnSync('npx', ['tsx', ...args], {
      stdio: rawJson ? 'pipe' : 'inherit',
      env: process.env,
    });

    if (rawJson) {
      const isSuccess = result.status === 0;
      console.log(
        JSON.stringify(
          {
            status: isSuccess ? 200 : 500,
            success: isSuccess,
            noSeeds,
            message: isSuccess
              ? 'Database reset completed successfully'
              : 'Database reset failed',
          },
          null,
          2
        )
      );
    }

    if (result.status !== 0) {
      process.exitCode = result.status || 1;
    }
    return;
  }

  console.error(`${colors.red}Acción desconocida:${colors.reset} "${action}" para el recurso ops. Usa --help para ver las acciones disponibles.`);
  process.exit(1);
}

// --- FUNCIÓN PRINCIPAL (ENTRYPOINT) ---
async function main() {
  const parsed = parseArgs(process.argv.slice(2));
  const baseUrl = parsed.flags['base-url'] || DEFAULT_BASE_URL;
  const rawJson = Boolean(parsed.flags['raw-json'] || parsed.flags.q);

  globalTraceHeaders = {};
  if (parsed.flags['request-id']) {
    globalTraceHeaders['X-Request-ID'] = String(parsed.flags['request-id']);
  }
  if (parsed.flags['correlation-id']) {
    globalTraceHeaders['X-Correlation-ID'] = String(parsed.flags['correlation-id']);
  }

  if (parsed.flags.version || parsed.flags.v) {
    console.log(`v${VERSION}`);
    return;
  }

  if (!parsed.resource) {
    printGeneralHelp();
    return;
  }

  switch (parsed.resource) {
    case 'auth':
      await handleAuthDomain(parsed.action, parsed.flags, baseUrl, rawJson);
      break;

    case 'users':
      await handleUsersDomain(parsed.action, parsed.flags, baseUrl, rawJson);
      break;

    case 'tenant':
      await handleTenantDomain(parsed.action, parsed.flags, rawJson);
      break;

    case 'secrets':
      await handleSecretsDomain(parsed.action, parsed.flags, baseUrl, rawJson);
      break;

    case 'audit':
      await handleAuditDomain(parsed.action, parsed.flags, baseUrl, rawJson);
      break;

    case 'client':
      await handleClientDomain(parsed.action, parsed.flags, baseUrl, rawJson);
      break;

    case 'token':
      await handleTokenDomain(parsed.action, parsed.flags, baseUrl, rawJson);
      break;

    case 'oidc':
      await handleOidcDomain(parsed.action, parsed.flags, baseUrl, rawJson);
      break;

    case 'session':
      await handleSessionDomain(parsed.action, parsed.flags, baseUrl, rawJson);
      break;

    case 'federation':
      await handleFederationDomain(parsed.action, parsed.flags, baseUrl, rawJson);
      break;

    case 'ops':
      await handleOpsDomain(parsed.action, parsed.flags, baseUrl, rawJson);
      break;

    default:
      console.error(`${colors.red}Recurso desconocido:${colors.reset} "${parsed.resource}". Usa --help para ver los recursos disponibles.`);
      process.exit(1);
  }
}

main().catch((err) => {
  console.error(`${colors.red}Error fatal de ejecución:${colors.reset}`, err.message || err);
  process.exit(1);
});

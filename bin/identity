// --- MANEJADOR DEL DOMINIO AUTH ---
async function handleAuthDomain(action, flags, baseUrl, rawJson) {
  if (!action || flags.help || flags.h) {
    printAuthHelp();
    return;
  }

  if (action === 'register') {
    const tenant = flags.tenant || flags['tenant-id'] || flags.t;
    const email = flags.email || flags.e;
    const password = flags.password || flags.p;
    const name = flags.name || flags.n;

    if (!tenant) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --tenant es obligatoria para registrar un usuario.`);
      process.exit(1);
    }
    if (!email) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --email es obligatoria para registrar un usuario.`);
      process.exit(1);
    }
    if (!password) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --password es obligatoria para registrar un usuario.`);
      process.exit(1);
    }

    const payload = { email, password };
    if (name) payload.name = name;

    const res = await requestHttp('POST', '/api/v1/auth/register', {
      baseUrl,
      headers: {
        'X-Tenant-ID': String(tenant),
      },
      body: payload,
    });

    renderResponse(res, rawJson);
    return;
  }

  if (action === 'me') {
    const tenant = flags.tenant || flags['tenant-id'] || flags.t;
    const token = flags.token;

    if (!tenant) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --tenant es obligatoria para consultar el perfil.`);
      process.exit(1);
    }
    if (!token) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --token es obligatoria para consultar el perfil.`);
      process.exit(1);
    }

    const res = await requestHttp('GET', '/api/v1/auth/me', {
      baseUrl,
      headers: {
        'X-Tenant-ID': String(tenant),
        Authorization: `Bearer ${String(token).replace(/^Bearer\s+/i, '')}`,
      },
    });

    renderResponse(res, rawJson);
    return;
  }

  if (action === 'update-user') {
    const tenant = flags.tenant || flags['tenant-id'] || flags.t;
    const token = flags.token;
    const userId = flags['user-id'] || flags.id || flags.u;
    const name = flags.name || flags.n;

    if (!tenant) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --tenant es obligatoria para actualizar un usuario.`);
      process.exit(1);
    }
    if (!token) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --token es obligatoria para actualizar un usuario.`);
      process.exit(1);
    }
    if (!userId) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --user-id es obligatoria para actualizar un usuario.`);
      process.exit(1);
    }

    const res = await requestHttp('PATCH', `/api/v1/users/${encodeURIComponent(String(userId))}`, {
      baseUrl,
      headers: {
        'X-Tenant-ID': String(tenant),
        Authorization: `Bearer ${String(token).replace(/^Bearer\s+/i, '')}`,
      },
      body: { name: name ? String(name) : 'Updated User' },
    });

    renderResponse(res, rawJson);
    return;
  }

  if (action === 'delete-user') {
    const tenant = flags.tenant || flags['tenant-id'] || flags.t;
    const token = flags.token;
    const userId = flags['user-id'] || flags.id || flags.u;

    if (!tenant) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --tenant es obligatoria para eliminar un usuario.`);
      process.exit(1);
    }
    if (!token) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --token es obligatoria para eliminar un usuario.`);
      process.exit(1);
    }
    if (!userId) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --user-id es obligatoria para eliminar un usuario.`);
      process.exit(1);
    }

    const res = await requestHttp('DELETE', `/api/v1/users/${encodeURIComponent(String(userId))}`, {
      baseUrl,
      headers: {
        'X-Tenant-ID': String(tenant),
        Authorization: `Bearer ${String(token).replace(/^Bearer\s+/i, '')}`,
      },
    });

    if (res.status === 204) {
      res.data = {
        status: 204,
        message: 'User deleted successfully',
        userId: String(userId),
        tenantId: String(tenant),
      };
    }

    renderResponse(res, rawJson);
    return;
  }

  if (action === 'create-root-admin') {
    return handleUsersDomain('create-root-admin', flags, baseUrl, rawJson);
  }

  console.error(`${colors.red}Acción desconocida:${colors.reset} "${action}" para el recurso auth. Usa --help para ver las acciones disponibles.`);
  process.exit(1);
}

function printUsersHelp() {
  console.log(`${colors.bold}Uso: identity users <accion> [banderas]${colors.reset}

${colors.bold}Acciones:${colors.reset}
  ${colors.cyan}create-root-admin${colors.reset} Registra un superadministrador en el root tenant ('system')
               Banderas:
                 --email <email>     Correo del operador (Requerido)
                 --password <pwd>    Contraseña segura (Requerido)

  ${colors.cyan}get${colors.reset}               Consulta el perfil de un usuario por su ID
               Banderas:
                 --tenant <id>       ID del inquilino objetivo (Requerido)
                 --user-id <uuid>    ID del usuario objetivo (Requerido)
                 --token <jwt>       Token de acceso Bearer (Requerido)

  ${colors.cyan}delete${colors.reset}            Elimina físicamente un usuario por su ID
               Banderas:
                 --tenant <id>       ID del inquilino objetivo (Requerido)
                 --user-id <uuid>    ID del usuario objetivo (Requerido)
                 --token <jwt>       Token de acceso Bearer (Requerido)

${colors.bold}Ejemplos:${colors.reset}
  identity users create-root-admin --email admin@angelpixel.io --password "SuperAdmin_2026!"
  identity users get --tenant acme-corp --user-id 4476ffac-2423-444b-8342-efbfe4dbaeba --token "$TOKEN"
  identity users delete --tenant acme-corp --user-id 4476ffac-2423-444b-8342-efbfe4dbaeba --token "$TOKEN"
`);
}

async function handleUsersDomain(action, flags, baseUrl, rawJson) {
  if (!action || flags.help || flags.h) {
    printUsersHelp();
    return;
  }

  if (action === 'create-root-admin') {
    const email = flags.email || flags.e;
    const password = flags.password || flags.p;

    if (!email) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --email es obligatoria para crear un root admin.`);
      process.exit(1);
    }
    if (!password) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --password es obligatoria para crear un root admin.`);
      process.exit(1);
    }

    const res = await requestHttp('POST', '/api/v1/auth/register', {
      baseUrl,
      headers: {
        'X-Tenant-ID': 'system',
      },
      body: {
        email,
        password,
        roles: ['superadmin', 'member'],
      },
    });

    renderResponse(res, rawJson);
    return;
  }

  if (action === 'get') {
    const tenant = flags.tenant || flags['tenant-id'] || flags.t;
    const token = flags.token;
    const userId = flags['user-id'] || flags.id || flags.u;

    if (!tenant) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --tenant es obligatoria para consultar un usuario.`);
      process.exit(1);
    }
    if (!token) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --token es obligatoria para consultar un usuario.`);
      process.exit(1);
    }
    if (!userId) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --user-id es obligatoria para consultar un usuario.`);
      process.exit(1);
    }

    const res = await requestHttp('GET', `/api/v1/users/${encodeURIComponent(String(userId))}`, {
      baseUrl,
      headers: {
        'X-Tenant-ID': String(tenant),
        Authorization: `Bearer ${String(token).replace(/^Bearer\s+/i, '')}`,
      },
    });

    renderResponse(res, rawJson);
    return;
  }

  if (action === 'delete') {
    return handleAuthDomain('delete-user', flags, baseUrl, rawJson);
  }

  console.error(`${colors.red}Acción desconocida:${colors.reset} "${action}" para el recurso users. Usa --help para ver las acciones disponibles.`);
  process.exit(1);
}

function printTenantHelp() {
  console.log(`${colors.bold}Uso: identity tenant <accion> [banderas]${colors.reset}

${colors.bold}Acciones:${colors.reset}
  ${colors.cyan}list-users${colors.reset}   Consulta usuarios en PostgreSQL bajo el rol restringido 'identity_app' (RLS)
               Banderas:
                 --tenant <id>           ID del inquilino para SET LOCAL app.current_tenant_id (Opcional; omitirlo activa Fail-Closed)
                 --limit <n>             Cantidad máxima de filas a retornar (def: 10)

  ${colors.cyan}insert-user${colors.reset}  Inserta un registro de usuario bajo una sesión de inquilino en PostgreSQL (RLS WITH CHECK)
               Banderas:
                 --session-tenant <id>   Inquilino activo en la sesión (SET LOCAL app.current_tenant_id) (Requerido)
                 --tenant <id>           Valor de tenant_id asignado a la fila a insertar (Requerido)
                 --email <email>         Correo electrónico del usuario (Requerido)
                 --id <uuid>             UUID explícito opcional para la fila

${colors.bold}Ejemplos:${colors.reset}
  identity tenant list-users --tenant acme-corp --limit 3
  identity tenant list-users
  identity tenant insert-user --session-tenant acme-corp --tenant beta-corp --email hacker@beta-corp.com
`);
}

// --- MANEJADOR DEL DOMINIO TENANT (POSTGRESQL RLS) ---
async function handleTenantDomain(action, flags, rawJson) {
  if (!action || flags.help || flags.h) {
    printTenantHelp();
    return;
  }

  if (action !== 'list-users' && action !== 'insert-user') {
    console.error(`${colors.red}Acción desconocida:${colors.reset} "${action}" para el recurso tenant. Usa --help para ver las acciones disponibles.`);
    process.exit(1);
  }

  const { spawnSync } = await import('child_process');
  const path = await import('path');
  const { fileURLToPath } = await import('url');
  const scriptPath = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../scripts/tenant-rls.ts');

  const args = [scriptPath, action];

  if (action === 'list-users') {
    const tenant = flags.tenant || flags['tenant-id'] || flags.t;
    const limit = flags.limit || flags.l;
    if (tenant && typeof tenant === 'string') {
      args.push('--tenant', tenant);
    }
    if (limit) {
      args.push('--limit', String(limit));
    }
  } else if (action === 'insert-user') {
    const sessionTenant = flags['session-tenant'] || flags.s;
    const tenant = flags.tenant || flags['tenant-id'] || flags.t;
    const email = flags.email || flags.e;
    const id = flags.id;

    if (!sessionTenant) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --session-tenant es obligatoria para insert-user.`);
      process.exit(1);
    }
    if (!tenant) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --tenant es obligatoria para insert-user.`);
      process.exit(1);
    }
    if (!email) {
      console.error(`${colors.red}Error:${colors.reset} La bandera --email es obligatoria para insert-user.`);
      process.exit(1);
    }

    args.push('--session-tenant', String(sessionTenant), '--tenant', String(tenant), '--email', String(email));
    if (id) {
      args.push('--id', String(id));
    }
  }

  if (rawJson) {
    args.push('--raw-json');
  }

  const result = spawnSync('npx', ['tsx', ...args], {
    stdio: 'inherit',
    env: process.env,
  });

  if (result.status !== 0) {
    process.exitCode = result.status || 1;
  }
}

function printSecretsHelp() {
  console.log(`${colors.bold}Uso: identity secrets <accion> [banderas]${colors.reset}

${colors.bold}Acciones (Gobernanza Root Tenant — ADR-0009 & US-16):${colors.reset}
  ${colors.cyan}status${colors.reset}                 Consulta telemetría en vivo de claves RSA/JWKS y generación del pool PostgreSQL
                         Banderas:
                           --token <jwt>             Token Bearer de Root Superadmin (Requerido)

  ${colors.cyan}rotate-signing-key${colors.reset}     Ejecuta un Hot Key Rollover asimétrico RSA-2048 real exponiendo ventana dual en JWKS
                         Banderas:
                           --token <jwt>             Token Bearer de Root Superadmin (Requerido)
                           --key-id <kid>            Identificador explícito para la nueva clave (Opcional)
                           --grace-ms <ms>           Ventana de gracia en milisegundos para la clave previa (Opcional)

  ${colors.cyan}rotate-db-credentials${colors.reset}  Ejecuta rotación generacional de credenciales PostgreSQL (Gen N -> N+1) con Fail-Safe
                         Banderas:
                           --token <jwt>             Token Bearer de Root Superadmin (Requerido)
                           --database-url <url>      URL PostgreSQL candidata (Opcional; una URL inválida dispara Fail-Safe 422)

${colors.bold}Ejemplos:${colors.reset}
  identity secrets status --token "\${ROOT_TOKEN}"
  identity secrets rotate-signing-key --token "\${ROOT_TOKEN}"
  identity secrets rotate-db-credentials --token "\${ROOT_TOKEN}"
  identity secrets rotate-db-credentials --token "\${ROOT_TOKEN}" --database-url "postgresql://bad_user:wrong_pass@localhost:5432/identity_db"
`);
}

// --- MANEJADOR DEL DOMINIO SECRETS (US-16 ROTACIÓN EN CALIENTE) ---
async function handleSecretsDomain(action, flags, baseUrl, rawJson) {
  if (!action || flags.help || flags.h) {
    printSecretsHelp();
    return;
  }

  const token = flags.token;
  if (!token) {
    console.error(`${colors.red}Error:${colors.reset} La bandera --token (Bearer de Root Superadmin) es obligatoria para operaciones de secrets.`);
    process.exit(1);
  }

  const authHeader = `Bearer ${String(token).replace(/^Bearer\s+/i, '')}`;

  if (action === 'status') {
    const res = await requestHttp('GET', '/api/v1/secrets/status', {
      baseUrl,
      headers: { Authorization: authHeader },
    });
    renderResponse(res, rawJson);
    return;
  }

  if (action === 'rotate-signing-key') {
    const body = {};
    if (flags['key-id']) body.keyId = String(flags['key-id']);
    if (flags['grace-ms']) body.gracePeriodMs = Number(flags['grace-ms']);

    const res = await requestHttp('POST', '/api/v1/secrets/rotate-signing-key', {
      baseUrl,
      headers: { Authorization: authHeader },
      body,
    });
    renderResponse(res, rawJson);
    return;
  }

  if (action === 'rotate-db-credentials') {
    const body = {};
    if (flags['database-url']) body.databaseUrl = String(flags['database-url']);

    const res = await requestHttp('POST', '/api/v1/secrets/rotate-db-credentials', {
      baseUrl,
      headers: { Authorization: authHeader },
      body,
    });
    renderResponse(res, rawJson);
    return;
  }

  console.error(`${colors.red}Acción desconocida:${colors.reset} "${action}" para el recurso secrets. Usa --help para ver las acciones disponibles.`);
  process.exit(1);
}

function printClientHelp() {
  console.log(`${colors.bold}Uso: identity client <accion> [banderas]${colors.reset}

${colors.bold}Acciones:${colors.reset}
  ${colors.cyan}validate${colors.reset}    Valida que una aplicación cliente exista, esté activa y tenga autorizado el origen web (CORS)
              Banderas:
                -c, --client-id <id>     ID de la aplicación cliente (Requerido)
                -o, --origin <url>       Origen HTTP que realiza la solicitud (Requerido)

${colors.bold}Ejemplos:${colors.reset}
  identity client validate --client-id portal-web --origin https://portal.angelpixel.io
  identity client validate -c m2m-service-app -o https://m2m.worker.local
`);
